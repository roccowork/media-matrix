{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/roccowork/media-matrix/video/schemas/shot.schema.json",
  "title": "ShotConfig v1（与 src/engine/shot.ts 保持一致）",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "renderer", "style", "fps", "duration", "camera", "post", "version", "assets"],
  "definitions": {
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
  },
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z]+(\\.[a-z0-9_]+)+\\.v[0-9]+$"},
    "renderer": {"enum": ["threejs", "blender", "motion"]},
    "style": {"enum": ["imax_cosmos", "cinematic_science", "cyber_tech", "motion_design", "history_geo"]},
    "fps": {"enum": [24, 25, 30, 60]},
    "duration": {"type": "number", "minimum": 1, "maximum": 120},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "keys"],
      "properties": {
        "preset": {"enum": ["dolly_in", "dolly_out", "orbit", "tracking", "fly_through", "macro_push", "pull_back", "keys"]},
        "ease": {"enum": ["smooth", "linear"]},
        "keys": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t", "pos", "look"],
            "properties": {
              "t": {"type": "number", "minimum": 0},
              "pos": {"$ref": "#/definitions/vec3"},
              "look": {"$ref": "#/definitions/vec3"},
              "fov": {"type": "number", "minimum": 10, "maximum": 100},
              "roll": {"type": "number", "minimum": -45, "maximum": 45}
            }
          }
        }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bloom": {"type": "object", "additionalProperties": false, "required": ["intensity"], "properties": {"intensity": {"type": "number", "minimum": 0, "maximum": 3}, "threshold": {"type": "number", "minimum": 0, "maximum": 5}, "radius": {"type": "number", "minimum": 0, "maximum": 1}}},
        "dof": {"type": "object", "additionalProperties": false, "required": ["cInf"], "properties": {"cInf": {"type": "number", "minimum": 0, "maximum": 24}, "focus": {"$ref": "#/definitions/vec3"}}},
        "tone": {"enum": ["aces", "agx", "neutral"]},
        "exposure": {"type": "number", "minimum": 0.1, "maximum": 4},
        "vignette": {"type": "number", "minimum": 0, "maximum": 1.5},
        "grain": {"type": "number", "minimum": 0, "maximum": 0.08},
        "chromatic": {"type": "number", "minimum": 0, "maximum": 0.01}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {"id": {"type": "string"}, "params": {"type": "object"}}
      }
    },
    "params": {"type": "object"}
  }
}
