{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/roccowork/media-matrix/video/schemas/storyboard.schema.json",
  "title": "Storyboard v1：一条视频的分镜 = 选题 + 待核验事实 + 按顺序首尾相接的镜头（每镜一个完整 ShotConfig）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "topic",
    "title",
    "fps",
    "generator",
    "facts",
    "shots",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$",
      "description": "日期-选题英文短名，同时作为每镜种子的前缀（每个视频用自己的种子）"
    },
    "topic": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "fps": {
      "enum": [
        24,
        25,
        30,
        60
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by"
      ],
      "properties": {
        "by": {
          "enum": [
            "ai",
            "hand"
          ],
          "description": "ai = 模型生成；hand = 人工手写（示例 / 修改稿）"
        },
        "model": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "repair_rounds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "description": "旁白里的事实性说法，制作前由用户核验",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "basis",
          "status"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "description": "依据 / 建议核对的来源（教科书、指南、论文）"
          },
          "status": {
            "enum": [
              "待核验",
              "已核验",
              "有误"
            ]
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 5,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "visual",
          "config"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "narration": {
            "type": "string",
            "description": "配音模式：这一镜念的旁白（中文约 4–5 字每秒）；配乐模式留空或不写"
          },
          "visual": {
            "type": "string",
            "description": "画面说明（给人看的）"
          },
          "note": {
            "type": "string",
            "description": "参数用了示意 / 慢放等非真实值时必须写"
          },
          "config": {
            "$ref": "shot.schema.json"
          },
          "onscreen": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "year": {
                "type": "string",
                "maxLength": 12,
                "description": "大字年份 / 时间标记，如 2125"
              },
              "text": {
                "type": "string",
                "description": "一句主谓宾完整的话，点明主语、说清这一镜（≤16 字，《方案补充》#22）"
              },
              "tag": {
                "type": "string",
                "maxLength": 8,
                "description": "角标，如「设想」（推测性画面必须标）"
              },
              "style": {
                "enum": [
                  "caption",
                  "title"
                ],
                "description": "caption = 左下角字卡（默认）；title = 居中大字（开场 / 点题句）"
              },
              "position": {
                "enum": [
                  "bottom",
                  "center",
                  "top"
                ],
                "description": "字的位置：bottom = 下方居中（默认）；center = 画面中央；top = 上方。选不遮挡画面主体的位置（#22）"
              }
            }
          },
          "transition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "description": "这一镜到下一镜的转场（《方案补充》#23）；不写 = 叠化 0.6 秒",
            "properties": {
              "type": {
                "enum": [
                  "dissolve",
                  "flash",
                  "zoom",
                  "eyelid",
                  "cut"
                ],
                "description": "dissolve 叠化；flash 白光爆闪；zoom 冲进画面中心、暖光穿出；eyelid 眼睛闭上后切黑；cut 硬切"
              },
              "duration": {
                "type": "number",
                "minimum": 0,
                "maximum": 2,
                "description": "叠化 / 转场时长（秒）"
              }
            }
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "voice",
            "music"
          ],
          "description": "voice = 配音（旁白按语速校验）；music = 只有配乐 + 画面文字（《方案补充》#17）"
        },
        "music": {
          "type": "string",
          "description": "配乐（用户选，如抖音曲名 / 文件）"
        },
        "bpm": {
          "type": "number",
          "minimum": 40,
          "maximum": 220,
          "description": "配乐节拍（有了就按节拍调切换点）"
        },
        "ambient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "src"
          ],
          "description": "全片环境底噪（循环，《方案补充》#25）",
          "properties": {
            "src": {
              "type": "string"
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mute": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "description": "静音区间 [开始秒, 结束秒]（如星光熄灭）"
            }
          }
        },
        "sfx": {
          "type": "array",
          "description": "音效（public/ 下的文件，按全片秒数放）",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src",
              "at"
            ],
            "properties": {
              "src": {
                "type": "string"
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
