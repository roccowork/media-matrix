ice": "explainer/2026-11-02-50/voice/06-6b156ec5bd.mp3", "shot": {"type": "points", "props": {"title": "记住三个词", "items": ["注意力：每个词看所有词", "并行：显卡一起算", "能堆大：越大越聪明"], "focus": 2}}}], "subs": [{"from": 0.5, "to": 2.5, "text": "你每天用的 ChatGPT、Claude"}, {"from": 2.62, "to": 4.02, "text": "背后其实是同一个发明"}, {"from": 4.18, "to": 4.74, "text": "Transformer"}, {"from": 4.9, "to": 5.94, "text": "它到底厉害在哪"}, {"from": 6.87, "to": 8.27, "text": "以前的 AI 读句子"}, {"from": 8.33, "to": 9.99, "text": "只能一个字一个字往后读"}, {"from": 10.07, "to": 11.43, "text": "读到后面就忘了前面"}, {"from": 11.75, "to": 13.35, "text": "Transformer 换了个思路"}, {"from": 13.43, "to": 13.91, "text": "所有的字"}, {"from": 14.07, "to": 14.47, "text": "一起看"}, {"from": 15.48, "to": 15.96, "text": "比如这句话"}, {"from": 16.52, "to": 17.92, "text": "小猫没有跳上桌子"}, {"from": 17.96, "to": 19.0, "text": "因为它太累了"}, {"from": 19.32, "to": 19.88, "text": "这个它"}, {"from": 19.96, "to": 20.52, "text": "指的是谁"}, {"from": 21.32, "to": 23.56, "text": "模型会让它去看句子里的每一个词"}, {"from": 23.64, "to": 25.48, "text": "发现和小猫关系最大"}, {"from": 25.6, "to": 26.6, "text": "这就叫注意力"}, {"from": 27.45, "to": 29.08, "text": "一个 Transformer 模块"}, {"from": 29.12, "to": 30.57, "text": "就是把这几层叠起来"}, {"from": 30.81, "to": 32.17, "text": "先把字变成数字"}, {"from": 32.33, "to": 33.05, "text": "加上位置"}, {"from": 33.21, "to": 34.01, "text": "再算注意力"}, {"from": 34.09, "to": 35.69, "text": "最后过一遍前馈网络"}, {"from": 36.62, "to": 37.42, "text": "2017 年"}, {"from": 37.5, "to": 39.02, "text": "谷歌的一篇论文提出了它"}, {"from": 39.34, "to": 39.82, "text": "第二年"}, {"from": 39.9, "to": 41.5, "text": "BERT 和 GPT 接连出现"}, {"from": 41.74, "to": 42.38, "text": "2022 年"}, {"from": 42.54, "to": 43.55, "text": "ChatGPT 上线"}, {"from": 44.51, "to": 45.63, "text": "而且它能一直堆大"}, {"from": 45.95, "to": 48.27, "text": "GPT-3 有一千七百五十亿个参数"}, {"from": 48.43, "to": 48.99, "text": "规模越大"}, {"from": 49.07, "to": 49.63, "text": "能力越强"}, {"from": 50.56, "to": 51.8, "text": "所以记住三个词"}, {"from": 52.08, "to": 54.16, "text": "注意力、并行、能堆大"}, {"from": 54.28, "to": 56.11, "text": "这就是今天大模型的心脏"}], "cover": {"lines": ["Transformer", "是怎么来的"], "hl": "Transformer", "sub": "一分钟看懂大模型的心脏"}}